# Copy this file to .env and update values.

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=media_rights
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MCP Server
MCP_SERVER_BASE_URL=http://localhost:8000
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# Orchestration / LLM - groq - ollama - openai - gemini
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Streamlit
STREAMLIT_SERVER_PORT=8501

# Observability / Logging
CONSOLE_LOGGING_ENABLED=true
LOG_LEVEL=INFO

# LangSmith tracing (optional)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentforge-local

Authors="Prajakt Thale and Krunal Tadwala"
Organization="CodeYogee-Labs (https://github.com/CodeYogee-Labs)"
